# OpinaCraft environment template.
# Never commit real values. Use separate values for Development, Preview and Production.

# Runtime database: Neon pooled connection (Development / Preview / Production).
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/opinacraft?sslmode=require

# Schema migrations only: Neon direct, non-pooled connection (Development / Preview / Production).
# Required by pnpm db:migrate and pnpm db:generate; never use the pooled URL here.
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/opinacraft?sslmode=require

# Better Auth (required at runtime; use a different secret per environment).
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins. Development example; Preview should include https://preview.opinacraft.com.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Server verification (required when MOTD verification is enabled; Development / Preview / Production).
SERVER_VERIFICATION_SECRET=replace-with-at-least-32-random-characters

# Password-reset email (optional in local Development; required when password reset is enabled elsewhere).
RESEND_API_KEY=
EMAIL_FROM=OpinaCraft <noreply@example.com>

# Discord OAuth (optional; configure separately per environment).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Test-only values. Use a dedicated Neon branch/database; never point this at Production.
TEST_DATABASE_URL=postgresql://user:password@ep-example-test.eu-central-1.aws.neon.tech/opinacraft_test?sslmode=require
E2E_BASE_URL=http://localhost:3000

# Vercel supplies VERCEL_ENV and VERCEL_URL automatically. Do not copy those values into this file.
# Preview deployment must set BETTER_AUTH_URL=https://preview.opinacraft.com.
# NEXT_PUBLIC_DISCORD_ENABLED is computed by next.config.ts from the Discord credentials.
