{
  "name": "opinacraft",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/validation.test.ts tests/verification.test.ts",
    "test:integration": "node scripts/bootstrap-test-database.mjs && node --experimental-strip-types --experimental-loader ./scripts/ts-paths-loader.mjs --test tests/integration.test.ts",
    "test:e2e": "playwright test",
    "db:inspect": "node scripts/inspect-database.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
    ,"admin:grant": "node scripts/grant-admin.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.0-beta.10",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/blob": "^2.6.1",
    "better-auth": "1.7.0-beta.10",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "ipaddr.js": "^2.4.0",
    "minecraft-protocol": "1.66.2",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
